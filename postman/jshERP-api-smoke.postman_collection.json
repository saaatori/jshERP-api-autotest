{
  "info": {
    "_postman_id": "0670c399-b7e3-4f15-b255-2b4feabbaefc",
    "name": "jshERP-api-smoke",
    "description": "管伊佳ERP冒烟集(简化版15条):登录→建商品→采购入库(欠款断言)→销售出库(库存断言)→清理。全程未审核保存(R4保存即入账),无订单/审核/转单。\n\n**必须配置:Runner Delay=2000ms**(防DEF-EXP-06防攻击注销:同用户同日志模块同IP~1.5s内二次操作即强制登出,1100ms实测不安全);Newman用 --delay 2000。\n演示数据ID:供应商57/客户58/仓库14/账户17(环境变量)。断言纪律:绝不只断言code==200。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "54248265",
    "_collection_link": "https://go.postman.co/collection/54248265-0670c399-b7e3-4f15-b255-2b4feabbaefc?source=collection_link"
  },
  "item": [
    {
      "name": "00_登录与鉴权",
      "item": [
        {
          "name": "登录",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"md5pwd\", CryptoJS.MD5(pm.environment.get(\"password\")).toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"登录成功(成败以msgTip判定,失败也是code200)\", () => {",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data.msgTip).to.eql(\"user can login\");",
                  "});",
                  "pm.test(\"token格式=UUID_租户ID(后缀63)\", () => {",
                  "    pm.expect(json.data.token).to.match(/^[0-9a-f]{32}_63$/);",
                  "});",
                  "pm.test(\"响应密码字段已脱敏\", () => pm.expect(json.data.user.password).to.be.null);",
                  "pm.environment.set(\"token\", json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"loginName\": \"{{loginName}}\",\n    \"password\": \"{{md5pwd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/jshERP-boot/user/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jshERP-boot",
                "user",
                "login"
              ]
            },
            "description": "密码明文123456,脚本内MD5后提交;验证码环境checkcode_flag=0"
          },
          "response": []
        },
        {
          "name": "会话验证",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"携带token返回会话信息\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data.user.id).to.eql(63);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Access-Token",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jshERP-boot/user/getUserSession",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jshERP-boot",
                "user",
                "getUserSession"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01_基础资料",
      "item": [
        {
          "name": "新增商品",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"runId\", Date.now().toString().slice(-6));",
                  "pm.environment.set(\"materialName\", \"EXPF\" + pm.environment.get(\"runId\"));",
                  "pm.environment.set(\"barCode\", \"EXPF\" + pm.environment.get(\"runId\"));",
                  "pm.environment.set(\"nowTime\", new Date().toLocaleString('sv-SE'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"商品新增成功\", () => pm.expect(json.code).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Access-Token",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{materialName}}\",\n    \"unit\": \"个\",\n    \"mnemonic\": \"EXPFsp\",\n    \"meList\": [\n        {\n            \"id\": \"\",\n            \"barCode\": \"{{barCode}}\",\n            \"commodityUnit\": \"个\",\n            \"sku\": \"\",\n            \"purchaseDecimal\": \"10\",\n            \"commodityDecimal\": \"20\",\n            \"wholesaleDecimal\": \"\",\n            \"lowDecimal\": \"20\"\n        }\n    ],\n    \"stock\": [],\n    \"sortList\": [],\n    \"unitId\": \"\",\n    \"imgName\": \"\",\n    \"meDeleteIdList\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/jshERP-boot/material/add",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jshERP-boot",
                "material",
                "add"
              ]
            },
            "description": "名称/条码用EXPF+runId保证可重复执行;采购价10零售价20最低售价20(出库单价=最低价放行)"
          },
          "response": []
        },
        {
          "name": "查询新增商品提ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const row = json.data.rows.find(r => r.name === pm.environment.get(\"materialName\"));",
                  "pm.test(\"按名称过滤到唯一商品(客户端过滤,规避URL编码坑)\", () => {",
                  "    pm.expect(row, \"未找到新建商品\").to.not.be.undefined;",
                  "});",
                  "pm.environment.set(\"materialId\", row.id);",
                  "console.log(\"基线库存:\", row.stock);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Access-Token",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jshERP-boot/material/list?currentPage=1&pageSize=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jshERP-boot",
                "material",
                "list"
              ],
              "query": [
                {
                  "key": "currentPage",
                  "value": "1"
